---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type FAQBlock = Extract<PageContentBlock, { _type: "marketing_faq" }>;
type Props = BlockComponentProps<FAQBlock>;

const { value } = Astro.props;
const { anchor_id, headline, items } = value;
---

<section class="faq section" id={anchor_id || undefined}>
	<div class="faq-stack">
		{headline && <h2 class="faq-title">{headline}</h2>}
		<div class="faq-list">
			{items.map((item, i) => (
				<details class="faq-item" name="faq" open={i === 0}>
					<summary class="faq-question">
						<span>{item.question}</span>
						<svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
							<path d="M12 5v14M5 12h14" />
						</svg>
					</summary>
					<p class="faq-answer">{item.answer}</p>
				</details>
			))}
		</div>
		<a class="faq-contact" href="/contact">
			<span class="faq-contact-text">
				<span>Still have a question?</span>
				<span>Talk to the WarpCart team.</span>
			</span>
			<svg class="faq-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M5 12h14M13 6l6 6-6 6" />
			</svg>
		</a>
	</div>
</section>

<style>
	.faq-stack {
		display: grid;
		gap: 32px;
		max-width: 720px;
		margin: 0 auto;
		padding-inline: var(--spacing-lg);
	}

	.faq-title {
		margin: 0;
		font-size: var(--font-size-3xl);
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.15;
		text-align: center;
		text-wrap: balance;
	}

	.faq-list {
		border-top: 1px solid var(--color-border);
	}

	.faq-item {
		border-bottom: 1px solid var(--color-border);
		interpolate-size: allow-keywords;
	}

	.faq-item::details-content {
		block-size: 0;
		overflow: hidden;
		opacity: 0;
		transition:
			block-size 250ms ease-out,
			opacity 200ms ease-out,
			content-visibility 250ms allow-discrete;
	}

	.faq-item[open]::details-content {
		block-size: auto;
		opacity: 1;
	}

	.faq-question {
		display: flex;
		min-height: 64px;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 16px 4px;
		font-size: var(--font-size-base);
		font-weight: 500;
		line-height: 1.5;
		cursor: pointer;
		list-style: none;
		-webkit-tap-highlight-color: transparent;
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	.faq-icon {
		width: 18px;
		height: 18px;
		flex: none;
		color: var(--color-muted);
		transition: transform 250ms ease-out, color 200ms ease-out;
	}

	.faq-item[open] .faq-icon {
		color: var(--color-text);
		transform: rotate(45deg);
	}

	.faq-answer {
		margin: 0;
		padding: 0 40px 20px 4px;
		color: var(--color-muted);
		font-size: var(--font-size-base);
		line-height: 1.6;
		text-wrap: pretty;
	}

	.faq-contact {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 16px 20px;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		color: var(--color-text);
		text-decoration: none;
		transition: background-color 200ms ease-out;
	}

	.faq-contact-text {
		display: grid;
		gap: 2px;
		font-size: var(--font-size-sm);
	}

	.faq-contact-text span:first-child {
		font-weight: 500;
	}

	.faq-contact-text span:last-child {
		color: var(--color-muted);
	}

	.faq-contact-icon {
		width: 18px;
		height: 18px;
		flex: none;
		color: var(--color-muted);
		transition: transform 200ms ease-out, color 200ms ease-out;
	}

	@media (hover: hover) and (pointer: fine) {
		.faq-question:hover .faq-icon,
		.faq-contact:hover .faq-contact-icon {
			color: var(--color-text);
		}

		.faq-contact:hover {
			background: var(--color-surface);
		}

		.faq-contact:hover .faq-contact-icon {
			transform: translateX(2px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item::details-content,
		.faq-icon,
		.faq-contact,
		.faq-contact-icon {
			transition: none;
		}
	}

	@media (max-width: 680px) {
		.faq-title {
			font-size: var(--font-size-2xl);
		}

		.faq-answer {
			padding-right: 4px;
		}
	}
</style>
