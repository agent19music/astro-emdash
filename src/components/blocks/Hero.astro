---
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import SiteButton from "../SiteButton";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, image, centered } = value;
const photoLanding = !centered;
const landingImage = image || {
	id: "",
	src: "/images/people/friends-on-phone.jpg",
	alt: "Two friends laughing together while looking at a phone",
	width: 1024,
	height: 682,
};

const appWord = "WhatsApp";
const [headlineBefore, ...headlineRest] =
	photoLanding && headline.includes(appWord) ? headline.split(appWord) : [headline];
const headlineTail = headlineRest.join(appWord);
const headlinePunctuation = headlineTail.match(/^[.,!?]*/)?.[0] ?? "";
const headlineAfter = headlineTail.slice(headlinePunctuation.length);
const apps = [
	{ name: "WhatsApp", src: "/images/logos/whatsapp.svg" },
	{ name: "Instagram", src: "/images/logos/instagram.svg" },
	{ name: "Messenger", src: "/images/logos/messenger.svg" },
	{ name: "Facebook", src: "/images/logos/facebook.svg" },
];

const primaryCta =
	value.primary_cta_label && value.primary_cta_url
		? { label: value.primary_cta_label, url: sanitizeHref(value.primary_cta_url) }
		: undefined;
const secondaryCta =
	value.secondary_cta_label && value.secondary_cta_url
		? { label: value.secondary_cta_label, url: sanitizeHref(value.secondary_cta_url) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={["hero", { "hero-centered": centered, "hero-with-image": !!image, "hero-photo-landing": photoLanding }]}
>
	<div class="hero-content">
		{photoLanding && <p class="hero-eyebrow">Built for Kenyan businesses</p>}
		<h1 class="hero-headline">
			{headlineRest.length > 0 ? (
				<>
					{headlineBefore}<span class="hero-apps-group"><span class="hero-apps"><span class="hero-apps-label">WhatsApp, Instagram, Messenger and Facebook</span>{apps.map((app) => (
							<span class="hero-app" aria-hidden="true"><img src={app.src} alt="" width="48" height="48" /></span>
						))}</span>{headlinePunctuation}</span>{headlineAfter}
				</>
			) : headline}
		</h1>
		{subheadline && <p class="hero-subheadline">{subheadline}</p>}
		{(primaryCta || secondaryCta) && (
			<div class="hero-actions">
				{primaryCta && (
					<SiteButton href={primaryCta.url} label={primaryCta.label} primary className="btn-lg" />
				)}
				{secondaryCta && (
					<SiteButton href={secondaryCta.url} label={secondaryCta.label} className="btn-lg" />
				)}
			</div>
		)}
	</div>
		{photoLanding ? (
			<div class="hero-story-grid">
				<div class="hero-human-photo"><Image image={landingImage} class="hero-people-media" priority /></div>
				<ul class="hero-notes" aria-hidden="true">
					<li class="hero-note hero-note-order">
						<div class="note-head">
							<img src="/images/products/spezial-sneakers.webp" alt="" width="40" height="40" class="note-thumb" />
							<span class="note-who">
								<strong>New order</strong>
								<span>Red Spezial · Size 42</span>
							</span>
							<span class="note-tag note-tag-success">Paid</span>
						</div>
						<p class="note-row"><span>Order #1042</span><strong>KES 9,500</strong></p>
					</li>
					<li class="hero-note hero-note-stock">
						<div class="note-head">
							<img src="/images/products/cherry-phone-case.webp" alt="" width="40" height="40" class="note-thumb" />
							<span class="note-who">
								<strong>Cherry phone case</strong>
								<span>iPhone 16 Pro</span>
							</span>
							<span class="note-tag note-tag-danger">Out of stock</span>
						</div>
						<div class="note-actions">
							<span class="note-pill note-pill-ink">Restock</span>
							<span class="note-pill">Hide item</span>
						</div>
					</li>
					<li class="hero-note hero-note-payment">
						<div class="note-head">
							<img src="/images/products/lipa-na-mpesa.webp" alt="" width="106" height="16" class="note-logo" />
							<span class="note-time">Just now</span>
						</div>
						<p class="note-paid">
							<strong class="note-amount">KES 9,500</strong>
							<span class="note-meta">from Mercy W.</span>
						</p>
					</li>
				</ul>
			</div>
		) : image ? (
			<div class="hero-image">
				<Image image={image} class="hero-image-media" priority />
		</div>
	) : null}
</section>

<style>
	.hero {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-4xl) var(--spacing-lg);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-2xl);
		align-items: center;
	}

	.hero-centered {
		grid-template-columns: 1fr;
		text-align: center;
		max-width: var(--max-width);
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-xl);
	}

	.hero-centered .hero-content {
		max-width: 100%;
	}

	.hero-centered .hero-actions {
		justify-content: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		max-width: 560px;
	}

	.hero-headline {
		font-size: var(--font-size-5xl);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		background: var(--gradient-headline);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subheadline {
		font-size: var(--font-size-xl);
		line-height: var(--leading-normal);
		color: var(--color-muted);
	}

	.hero-actions {
		display: flex;
		gap: var(--spacing-md);
		flex-wrap: wrap;
	}

	.hero-image {
		position: relative;
	}

	.hero-image :global(.hero-image-media) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-xl);
	}

	.hero-image::before {
		content: "";
		position: absolute;
		inset: -10px;
		background: var(--gradient-brand-soft);
		border-radius: var(--radius-lg);
		z-index: -1;
		opacity: 0.3;
		filter: blur(20px);
	}

	/* Hero visual (external SVG image) */
	.hero-visual {
		position: relative;
		width: 100%;
		max-width: 550px;
		justify-self: center;
	}

	.hero-visual img {
		width: 100%;
		height: auto;
	}

	@media (max-width: 1024px) {
		.hero {
			grid-template-columns: 1fr;
			padding: var(--spacing-2xl) var(--spacing-lg);
			gap: var(--spacing-2xl);
		}

		.hero-headline {
			font-size: var(--font-size-4xl);
		}

		.hero-subheadline {
			font-size: var(--font-size-lg);
		}

		.hero-with-image {
			text-align: center;
		}

		.hero-with-image .hero-actions {
			justify-content: center;
		}

		.hero-image,
		.hero-visual {
			order: -1;
		}
	}
</style>
