---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/kumo.css";
import "../styles/tokens.css";
import "../styles/theme.css";
import LogoMark from "../components/LogoMark.astro";
import SiteButton from "../components/SiteButton";
import { resolveSiteLink } from "../lib/site-links";
import { getSocialImageMeta, homeSeo } from "../lib/seo";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	imageMeta?: { width: number; height: number; alt: string; type?: string };
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, imageMeta, canonical, robots, content } = Astro.props;
const socialImage = new URL(image || "/images/warpcart-og.png", Astro.url.origin).href;
const socialImageMeta = imageMeta ?? getSocialImageMeta(socialImage);
const [settingsResult, menuResult, footerProductResult, footerCompanyResult, footerSupportResult] =
	await Promise.all([
		getSiteSettingsWithCacheHint(),
		getMenuWithCacheHint("primary"),
		getMenuWithCacheHint("footer_product"),
		getMenuWithCacheHint("footer_company"),
		getMenuWithCacheHint("footer_support"),
	]);

if (Astro.cache?.enabled) {
	for (const result of [
		settingsResult,
		menuResult,
		footerProductResult,
		footerCompanyResult,
		footerSupportResult,
	]) {
		Astro.cache.set(result.cacheHint);
	}
}

const settings = settingsResult.data;
const siteTitle = settings?.title || "WarpCart";
const fullTitle = title ? (title.includes(siteTitle) ? title : `${title} — ${siteTitle}`) : siteTitle;
const siteDescription =
	settings?.tagline || homeSeo.description;
const siteLogo = settings.logo?.url ? settings.logo : null;
const menu = menuResult.data;
const footerProduct = footerProductResult.data;
const footerCompany = footerCompanyResult.data;
const footerSupport = footerSupportResult.data;

const footerLinks = [footerProduct, footerCompany, footerSupport]
	.flatMap((menu) => menu?.items ?? [])
	.filter((item, i, all) => all.findIndex((other) => other.url === item.url) === i);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteDescription,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image: socialImage,
	content,
	seo: { ogTitle: fullTitle, ogImage: socialImage, robots: robots ?? "index, follow, max-image-preview:large" },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111111" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<meta property="og:locale" content="en_KE" />
		{socialImageMeta && <>
			<meta property="og:image:width" content={socialImageMeta.width} />
			<meta property="og:image:height" content={socialImageMeta.height} />
			{socialImageMeta.type && <meta property="og:image:type" content={socialImageMeta.type} />}
			<meta property="og:image:alt" content={socialImageMeta.alt} />
			<meta name="twitter:image:alt" content={socialImageMeta.alt} />
		</>}
		<meta name="twitter:site" content="@uzski404" />
		<Font cssVariable="--font-body" preload />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="site-logo">
					{siteLogo
						? <img
							src={siteLogo.url}
							alt={siteLogo.alt || siteTitle}
							width={siteLogo.width}
							height={siteLogo.height}
							class="site-logo-img"
						/>
						: <><LogoMark class="logo-mark" />{siteTitle}</>
					}
				</a>
				<div class="nav-links">
					{
						menu?.items.map((item) => (
							<a
								href={resolveSiteLink(item.url)}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</div>
				<div class="nav-actions">
					{isLoggedIn && <a href="/_emdash/admin" class="nav-admin">Admin</a>}
					<SiteButton href="/contact" label="Get Started" primary className="nav-cta" />
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-content">
				<a href="/" class="footer-logo">
					{siteLogo
						? <img
							src={siteLogo.url}
							alt={siteLogo.alt || siteTitle}
							width={siteLogo.width}
							height={siteLogo.height}
							class="footer-logo-img"
						/>
						: <><LogoMark class="logo-mark" />{siteTitle}</>
					}
				</a>
				{footerLinks.length > 0 && (
					<nav class="footer-nav" aria-label="Footer">
						{footerLinks.map((item) => (
							<a
								href={resolveSiteLink(item.url)}
								target={item.target}
								rel={item.target ? "noopener noreferrer" : undefined}>
								{item.label}
							</a>
						))}
					</nav>
				)}
				<div class="footer-divider"></div>
				<p class="footer-copy">&copy; {new Date().getFullYear()} {siteTitle}</p>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script>
			const header = document.querySelector<HTMLElement>(".site-header");
			const hero = document.querySelector<HTMLElement>("main .hero");

			if (header) {
				const setFloating = (floating: boolean) => header.classList.toggle("is-floating", floating);

				if (hero) {
					new IntersectionObserver(
						([entry]) => setFloating(!entry.isIntersecting && entry.boundingClientRect.top < 0),
						{ rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
					).observe(hero);
				} else {
					const update = () => setFloating(window.scrollY > header.offsetHeight);
					update();
					window.addEventListener("scroll", update, { passive: true });
				}
			}
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				@media (prefers-reduced-motion: reduce) {
					html {
						scroll-behavior: auto;
					}

					*,
					*::before,
					*::after {
						scroll-behavior: auto !important;
						transition-duration: 0.01ms !important;
					}
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100svh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: currentColor;
					text-decoration: none;
				}

					/* Bare links in authored content need a visible style; component
					   links restyle themselves via classes. */
				p a:not([class]),
				li a:not([class]) {
					color: var(--color-brand);
					text-decoration: underline;
					text-underline-offset: 2px;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-size: var(--font-size-5xl);
				}
				h2 {
					font-size: var(--font-size-3xl);
				}
				h3 {
					font-size: var(--font-size-2xl);
				}
				h4 {
					font-size: var(--font-size-xl);
				}

				/* Utility classes */
				.container {
					max-width: var(--wide-width);
					margin: 0 auto;
					padding: 0 var(--spacing-lg);
				}

				.section {
					padding: var(--spacing-5xl) 0;
				}

				.section-header {
					text-align: center;
					max-width: var(--max-width);
					margin: 0 auto var(--spacing-4xl);
				}

				.section-headline {
					font-size: var(--font-size-3xl);
					font-weight: var(--font-weight-display);
				}

				.section-subheadline {
					margin-top: var(--spacing-md);
					font-size: var(--font-size-lg);
					color: var(--color-muted);
				}

				.icon-tile {
					width: 48px;
					height: 48px;
					display: flex;
					align-items: center;
					justify-content: center;
					flex-shrink: 0;
					font-size: 1.5rem;
					color: var(--color-on-brand);
					background: var(--gradient-brand);
					border-radius: var(--radius);
				}

				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-sm);
					padding: var(--spacing-sm) var(--spacing-lg);
					font-family: inherit;
					font-size: var(--font-size-sm);
					font-weight: 600;
					border-radius: var(--radius);
					cursor: pointer;
					transition:
						background var(--transition-fast),
						transform var(--transition-fast),
						box-shadow var(--transition-fast);
				}

				@media (hover: hover) and (pointer: fine) {
					.btn:hover {
						transform: translateY(-1px);
					}

					.btn-primary:hover {
						background: var(--gradient-brand);
						box-shadow: var(--shadow-lg);
					}

					.btn-secondary:hover {
						background: var(--color-surface);
						border-color: var(--color-muted);
					}
				}

				.btn:active {
					transform: translateY(0);
				}

				.btn-primary {
					color: var(--color-on-brand);
					background: var(--gradient-brand-strong);
					border: none;
					transition:
						background 0.3s ease,
						box-shadow 0.3s ease,
						transform var(--transition-fast);
				}

				.btn-secondary {
					color: var(--color-text);
					background: transparent;
					border: 1px solid var(--color-border);
				}

				.btn-lg {
					padding: var(--spacing-md) var(--spacing-xl);
					font-size: var(--font-size-base);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				padding-inline: env(safe-area-inset-left, 0px) env(safe-area-inset-right, 0px);
				background: var(--color-bg);
				border-bottom: 1px solid var(--color-border);
				transition:
					padding 250ms ease-out,
					background-color 250ms ease-out,
					border-color 250ms ease-out;
			}

			.nav {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 16px 24px;
				display: flex;
				flex-wrap: nowrap;
				align-items: center;
				gap: var(--spacing-lg);
				border: 1px solid transparent;
				border-radius: 999px;
				transition:
					max-width 250ms ease-out,
					padding 250ms ease-out,
					background-color 250ms ease-out,
					border-color 250ms ease-out,
					box-shadow 250ms ease-out;
			}

			/* Header padding + pill padding add up to the resting padding,
			   so the sticky header keeps its height and the page never shifts. */
			.site-header.is-floating {
				padding-block: 8px;
				background: transparent;
				border-bottom-color: transparent;
			}

			.site-header.is-floating .nav {
				max-width: 720px;
				padding: 8px 8px 8px 24px;
				background: color-mix(in srgb, var(--color-bg) 82%, transparent);
				border-color: var(--color-border);
				box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
				-webkit-backdrop-filter: saturate(180%) blur(16px);
				backdrop-filter: saturate(180%) blur(16px);
			}

			.site-header.is-floating :global(.nav-cta) {
				border-radius: 999px;
			}

			@media (prefers-reduced-transparency: reduce) {
				.site-header.is-floating .nav {
					background: var(--color-bg);
					-webkit-backdrop-filter: none;
					backdrop-filter: none;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.site-header,
				.nav {
					transition: none;
				}
			}

			.site-logo {
				font-size: var(--font-size-xl);
				font-weight: var(--font-weight-display);
				letter-spacing: var(--tracking-tight);
				background: var(--gradient-brand);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}

			.site-logo-img {
				height: 48px;
				width: auto;
				display: block;
				margin: -8px 0;
			}

			.nav-links {
				display: flex;
				flex-wrap: wrap;
				gap: var(--spacing-lg);
				margin-left: auto;
			}

			.nav-links a {
				font-size: var(--font-size-sm);
				font-weight: 500;
				color: var(--color-muted);
				transition: color var(--transition-fast);
			}

			.nav-links a:active,
			.footer-nav a:active {
				color: var(--color-text);
			}

			@media (hover: hover) and (pointer: fine) {
				.nav-links a:hover,
				.footer-nav a:hover {
					color: var(--color-text);
				}
			}

			.nav-actions {
				display: flex;
				align-items: center;
				gap: var(--spacing-lg);
			}

			.nav-admin {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				opacity: 0.5;
			}

			/* Compact variant of .btn.btn-primary for the header */
			.nav-cta {
				padding: var(--spacing-sm) var(--spacing-md);
				border-radius: var(--radius-sm);
			}

			main {
				min-height: calc(100svh - 200px);
			}

			.site-footer {
				background: var(--color-surface);
				border-top: 1px solid var(--color-border);
			}

			.footer-content {
				max-width: 896px;
				margin: 0 auto;
				padding: 64px var(--spacing-lg) calc(48px + env(safe-area-inset-bottom, 0px));
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 32px;
			}

			.footer-logo {
				font-size: var(--font-size-base);
				font-weight: 600;
				letter-spacing: var(--tracking-tight);
				color: var(--color-text);
			}

			.footer-logo-img {
				height: 24px;
				width: auto;
			}

			.footer-nav {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 8px 24px;
			}

			.footer-nav a {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				transition: color 200ms ease-out;
			}

			.footer-divider {
				width: 100%;
				height: 1px;
				background: var(--color-border);
			}

			.footer-copy {
				font-size: var(--font-size-xs);
				color: var(--color-muted);
			}

			@media (max-width: 768px) {
				h1 {
					font-size: var(--font-size-4xl);
				}
				h2 {
					font-size: var(--font-size-2xl);
				}
			}

			@media (max-width: 680px) {
				.footer-content {
					padding-block: 48px calc(32px + env(safe-area-inset-bottom, 0px));
					gap: 24px;
				}
			}

			/* One row on phones: the hero carries the primary CTA, so the
			   header keeps only the logo and section links. */
			@media (max-width: 540px) {
				.nav {
					padding: 12px 16px;
					gap: 16px;
				}

				.site-logo {
					font-size: var(--font-size-lg);
				}

				.nav-links {
					flex-wrap: nowrap;
					gap: 16px;
				}

				.nav-links a {
					padding-block: 12px;
				}

				.nav-actions {
					display: none;
				}

				.site-header.is-floating {
					padding: 8px max(8px, env(safe-area-inset-right, 0px)) 8px max(8px, env(safe-area-inset-left, 0px));
				}

				.site-header.is-floating .nav {
					padding: 4px 16px;
				}
			}
		</style>
	</body>
</html>
