---
import SiteButton from "../components/SiteButton";
import Base from "../layouts/Base.astro";

const portfolio = "https://sean.uzskicorp.agency";
const email = "seanmotanya@gmail.com";

// Phosphor icon paths (256 × 256), inlined.
